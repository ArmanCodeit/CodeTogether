{
  "name": "codetogether",
  "version": "2.4.0",
  "description": "CodeTogether - Real-time Collaborative Developer Workspace",
  "main": "server/src/server.js",
  "scripts": {
    "server": "node server/src/server.js",
    "server:dev": "node --watch server/src/server.js",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "start": "node server/src/server.js",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
